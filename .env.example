# ------------------------------------------------------------------
# Database (MySQL 8)
# Usernames are fixed in docker-compose.yml / mysql/bootstrap.sh:
#   plasticid_api     - FastAPI runtime (least privilege)
#   plasticid_ci      - CodeIgniter runtime (least privilege)
#   plasticid_migrate - `php spark migrate` only (DDL)
# Passwords: provide the same values in this file and in the container env
# (bootstrap.sh validates them; nothing is auto-generated).
# ------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=plasticid_db
API_DB_PASSWORD=change_me
CI_DB_PASSWORD=change_me
MIGRATE_DB_PASSWORD=change_me

# Redis (rate limiting). Embedded in REDIS_URL by docker-compose.yml.
REDIS_PASSWORD=change_me

# ------------------------------------------------------------------
# API keys
# API_KEY is the superuser master key: it lives only in the environment,
# is never stored in the database, and authorizes every /v1 admin endpoint.
# ------------------------------------------------------------------
API_KEY=change_me_to_random_string

# Demo key for the portal playground (auto-registered in api_keys as
# owner 'portal' when the API starts).
PORTAL_API_KEY=pk_change_me_to_random_string
PORTAL_REQUESTS_PER_MINUTE=20

# Optional override for FastAPI -> CI calls (defaults to API_KEY).
# CI_API_KEY=

# Optional FastAPI overrides (docker-compose applies these defaults; uncomment to change).
# CI_ENDPOINT=http://ci/api/predictions
# PORTAL_RATE_LIMIT=100
# PORTAL_RATE_WINDOW=60
# MAX_IMAGE_EDGE=1280
# MAX_IMAGE_PIXELS=40000000
# CACHE_MAX_IMAGE_SIZE=2097152

# Runtime
CI_ENVIRONMENT=production
DB_STARTUP_ATTEMPTS=10
DB_STARTUP_DELAY=2
DB_STARTUP_REQUIRED=1
DB_DEBUG=0
RATE_LIMIT_REDIS_REQUIRED=1
OUTBOX_WORKER_ENABLED=1
OUTBOX_POLL_INTERVAL=5
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=12
DB_MAX_CONNECTIONS=10
DB_CONNECT_TIMEOUT=5
OUTBOX_CLAIM_TIMEOUT_SECONDS=300
INFERENCE_LOCK_TIMEOUT=30
READ_RATE_LIMIT=120
READ_RATE_WINDOW=60
RATE_LIMIT_MEMORY_MAX_KEYS=10000
APP_BASE_URL=http://localhost:8080/
APP_ALLOWED_HOSTNAMES=
CORS_ALLOWED_ORIGINS=http://localhost:8080
FASTAPI_BASE_URL=http://plasticid-fastapi:8000
FASTAPI_PUBLIC_URL=http://localhost:8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Paths
# DATA_PATH is resolved and expanded by src/training/train.py
DATA_PATH=/app/data/images
# Classifier model loaded by the inference API and written by train.py
MODEL_PATH=/app/models/best_v8m.pt
DETECTOR_PATH=/app/yolov8n.pt
